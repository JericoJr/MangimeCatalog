<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Browse</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <div class="header">
        <div class="title-section">
            <h1 class="website-name">Mangime Catalog</h1>
        </div>
        <div class="links-section">
            <nav>
                <a href="/Home">Home</a>
                <a href="/Browse">Browse</a>
                <a href="/myStuff">MyStuff</a>
                <a href="/account">Account</a>
            </nav>
        </div>
    </div>

    <div class="body-content">
        <div class="browse-section">
            <h1>Browse</h1>
            <div class="Browse-Pages">
                <button id="Browse-Top"> Top </button>
                <span class="horizontal-line"> | </span>
                <button id="Browse-Current-Upcoming"> Current/Upcoming </button>
                <span class="horizontal-line"> | </span>
                <button id="Browse-Search"> Search </button>
            </div>
            <!--Pages-->

            <!--Top-->
            <div id="top-section">
                <div class="topAnime-section">
                    <div class="topAnime-content">
                        <h2>Top Anime</h2>
                        <table class="topAnimeTable">
                            <colgroup>
                                <col style="width: 5%">   
                                <col style="width: 21%">  
                                <col style="width: 32%">   
                                <col style="width: 22%">  
                                <col style="width: 15%">    
                            </colgroup>
                            <thead class="topHeaderTable">
                                <tr><th class="topAnimeRank">Rank</th><th class="topAnimePic"></th><th class="topAnimeTitle">Title</th><th class="topAnimeGenres">Genres</th><th class="topAnimeStatus">Status</th></tr>
                            </thead>
                            <tbody class="topBodyTable">
                                <%- topAnimeList %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="topManga-section">
                    <div class="topManga-content">
                        <h2>Current Anime</h2>
                        <table class="topMangaTable">
                            <colgroup>
                                <col style="width: 5%">   
                                <col style="width: 21%">  
                                <col style="width: 32%">   
                                <col style="width: 22%">  
                                <col style="width: 15%">    
                            </colgroup>
                            <thead class="topHeaderTable">
                                <tr><th class="topMangaRank">Rank</th><th class="topMangaPic"></th><th class="topMangaTitle">Title</th><th class="topMangaGenres">Genres</th><th class="topMangaStatus">Status</th></tr>
                            </thead>
                            <tbody class="topBodyTable">
                                <%- topMangaList %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!--Current/Upcoming-->
            <div id="current-upcoming-section">
                <div class="current-section">
                    <div class="current-content">
                        <h2 class="current-title">Current Season's Anime</h2>
                        <table class="currentTable">
                            <colgroup>
                                <col style="width: 17%">   
                                <col style="width: 25%">  
                                <col style="width: 20%">   
                                <col style="width: 18%">  
                                <col style="width: 10%"> 
                                <col style="width: 5%">    
                            </colgroup>
                            <thead class="currentHeaderTable">
                                <tr>
                                    <th class="currentImg"></th>
                                    <th class="currentTitle">Title</th>
                                    <th class="currentGenres">Genres</th>
                                    <th class="currentStatus">Status</th>
                                    <th class="currentScore">Score</th>
                                    <th class="currentEpisodes">Episodes</th>
                                </tr>
                            </thead>
                            <tbody class="currentBodyTable">
                                <%- currentList %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="upcoming-section">
                    <div class="upcoming-content">
                        <h2 class="upcoming-title">Upcoming Anime</h2>
                        <table class="upcomingTable">
                            <colgroup>
                                <col style="width: 17%">   
                                <col style="width: 25%">  
                                <col style="width: 10%">   
                                <col style="width: 20%">  
                                <col style="width: 9%"> 
                                <col style="width: 14%">    
                            </colgroup>
                            <thead class="upcomingHeaderTable">
                                <tr>
                                    <th class="upcomingImg"></th>
                                    <th class="upcomingTitle">Title</th>
                                    <th class="upcomingType">Type</th>
                                    <th class="upcomingGenres">Genres</th>
                                    <th class="upcomingSeason">Season</th>
                                    <th class="upcomingTrailer">Trailer</th>
                                </tr>
                            </thead>
                            <tbody class="upcomingBodyTable">
                                <%- upcomingList %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!--Search-->
            <div id="search-section">
                <div class="search-content">
                    <div class="search-title-container">
                        <h2 class="search-title">Search</h2>
                    </div>
                    <div class="search-form-container">
                        <form class="search-form" action="/browse/search" method="POST">
                            <fieldset class="search-fieldset">
                                <div class="search-form-fields">
                                    <label> Type:
                                        <select class="searchContentType" name="searchContentType">
                                            <option value="Anime">Anime</option>
                                            <option value="Manga">Manga</option>
                                        </select> 
                                    </label> 

                                    <label> Filter:</label> 
                                    <div class="searchFilter-section">
                                        <label> <input type="radio" class="searchFilter" name="searchFilter" value="Title" required> Title: </label> 
                                        <div id="titleInputSection">
                                            <input type="text" class="searchTitle" name="searchTitle" placeholder="Type Title"  autocomplete="on"> 
                                        </div>

                                        <label> <input type="radio" class="searchFilter" name="searchFilter" value="Genres"> Genres: </label> 
                                        <div id="genreInputSection">
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="1">Action</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="2">Adventure</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="46">Award Winning</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="4">Comedy</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="8">Drama</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="10">Fantasy</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="47">Gourment</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="13">Historical</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="14">Horror</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="62">Isekai</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="7">Mystery</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="17">Martial Arts</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="18">Mecha</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="67">Medical</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="38">Military</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="19">Music</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="6">Mythology</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="20">Parody</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="40">Psychological</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="72">Reincarnation</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="22">Romance</label> 
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="23">School</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="36">Slice Of Life</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="29">Space</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="30">Sports</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="37">Supernatural</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="31">Super Power</label>
                                            <label><input type="checkbox" class="searchGenreInput" name="searchGenre" value="76">Survival</label>
                                        </div>
                                        
                                        <div class="search-buttons-container">
                                            <input class="search-reset" type="reset">
                                            <button id="search-button"> Search </button> 
                                        </div>
                                    </div>
                     
                                </div>
                            </fieldset>
                        </form>
                    </div>
                    <div class="search-results-container">
                        <%- searchResults %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!--Popup-->
    <div id="showContent-Popup">
        <div class="popup-btn-section">
            <button id="cancel-review">X</button>
        </div>
        <hr class="review-line">
        <div id="popup-content">

        </div>
    </div>
    
    <script>
        // This runs in the browser
        document.addEventListener("DOMContentLoaded", () => {
            const topBtn = document.getElementById("Browse-Top");
            const cuBtn = document.getElementById("Browse-Current-Upcoming");
            const searchBtn = document.getElementById("Browse-Search");

            const topSection = document.getElementById("top-section");
            const cuSection = document.getElementById("current-upcoming-section");
            const searchSection = document.getElementById("search-section");

            // Initial section visibility
            const showSection = "<%= showSection || '' %>"; 
             if(showSection === "search") {
                searchSection.style.display = "flex";
                topSection.style.display = "none";
                cuSection.style.display = "none";
            } else {
                topSection.style.display = "flex";
                cuSection.style.display = "none";
                searchSection.style.display = "none";
            }

            topBtn.addEventListener("click", () => {
                topSection.style.display = "flex";
                cuSection.style.display = "none";
                searchSection.style.display = "none";
            });

            cuBtn.addEventListener("click", () => {
                cuSection.style.display = "flex";
                topSection.style.display = "none";
                searchSection.style.display = "none";
            });

            searchBtn.addEventListener("click", () => {
                searchSection.style.display = "flex";
                cuSection.style.display = "none";
                topSection.style.display = "none";
            });

            //For Search Filters
            const titleDiv = document.getElementById("titleInputSection");
            const genreDiv = document.getElementById("genreInputSection");

            document.querySelectorAll('.searchFilter').forEach(filter => { 
                filter.addEventListener("change", () => {
                    if(filter.value == "Title" && filter.checked) {
                        titleDiv.style.display = "flex";
                        genreDiv.style.display = "none";
                    } else {
                        titleDiv.style.display = "none";
                        genreDiv.style.display = "grid";
                    }
                });
            });

            //For review popups            
            const reviewBtns = document.querySelectorAll(`.review-btn`);
            const popup = document.getElementById("showContent-Popup");

            const cancelReviewBtn = document.getElementById("cancel-review");
            cancelReviewBtn.addEventListener("click", () => {
                popup.style.display = "none";
            });

            reviewBtns.forEach(btn => {
                btn.addEventListener("click", async (e) => {
                    e.preventDefault(); // stops page navigation
                    if(popup.style.display == "none") {
                        popup.style.display = "flex";


                        const contentID = btn.dataset.id;   
                        const contentType = btn.dataset.type;

                        //document.querySelector('.popup-content').innerHTML = `<p>id: ${contentID || "none"}, type: ${contentType | "none"}</p>`;

                        console.log("Dataset:", btn.dataset); 

                        const response = await fetch("/browse/reviewContent", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                contentID,
                                contentType
                            })
                        });
                        console.log("Response status:", response.status);

                        if (!response.ok) {
                            const text = await response.text();
                            console.error("Server returned:", text);
                            return;
                        }

                        const result = await response.json();
                        // console.log(result);
                        const data = result.data;
                        // Use JSON to update the page
                        document.getElementById("popup-content").innerHTML = `
                                <span class="item-header">${data.title}</span>
                                <div class="item-summary">
                                    <span class="item-title">Summary:</span>
                                    <span class="item-text">${data.synopsis || "none"}</span>
                                </div>   
                                <div class="item-background">
                                    <span class="item-title">Background:</span>
                                    <span class="item-text">${data.background || "none"}</span>
                                </div>
                                <div class="item-reviews">
                                    <span class="item-title">Reviews:</span>
                                </div>
                        `;
                    } else {
                        popup.style.display = "none";
                    }
                });
            });
        });


            


    
    </script>
</body>
</html>